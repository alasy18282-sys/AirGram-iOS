+    w.u32(tl.VECTOR)
+    w.i32(7)
+    for color_id in range(7):
+        base = _HELP_PEER_BASE_COLORS[color_id % len(_HELP_PEER_BASE_COLORS)]
+        dark = _darken_rgb(base)
+        w.u32(_HELP_PEER_COLOR_OPTION)
