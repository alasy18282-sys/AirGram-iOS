+def _darken_rgb(color: int, num: int = 7, den: int = 10) -> int:
+    r = (color >> 16) & 0xFF
+    g = (color >> 8) & 0xFF
+    b = color & 0xFF
+    r = max(0, min(255, (r * num) // den))
+    g = max(0, min(255, (g * num) // den))
+    b = max(0, min(255, (b * num) // den))
+    return (r << 16) | (g << 8) | b
+
+
+def _pack_help_peer_colors(req_hash: int, *, profile: bool = False) -> bytes:
+    if req_hash and int(req_hash) == _HELP_PEER_COLORS_HASH:
